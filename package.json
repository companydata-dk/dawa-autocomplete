    "core-js": "^2.6.11",
    "eslint": "^5.16.0",
    "regenerator-runtime": "^0.13.3",
    "rimraf": "^2.7.1",
    "rollup": "^1.29.1",
    "rollup-plugin-babel": "^4.3.3",
    "rollup-plugin-terser": "^5.2.0",
